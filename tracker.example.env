# Copy this file to tracker.local.env and edit only the values you need.
# tracker.local.env is Git-ignored.

# Pipe-separated list. Scanning more than one folder is safe; duplicate messages
# are deduplicated before the private importer sees them.
APPLE_MAIL_PROMO_FOLDERS="INBOX"
APPLE_MAIL_PROMO_DAYS=60

# Rename this to the exact mailbox shown by:
# osascript -l JavaScript mac/list-mailboxes.js
APPLE_MAIL_RECEIPT_FOLDER="Uber Receipts"
APPLE_MAIL_RECEIPT_DAYS=3650

TRACKER_PRIVATE_DB="uber-tracker.local.db"
