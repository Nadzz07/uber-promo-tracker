# Copy this file to tracker.local.env and edit only the values you need.
# tracker.local.env is Git-ignored.

# Pipe-separated list. Scanning more than one folder is safe; duplicate messages
# are deduplicated before the private importer sees them.
APPLE_MAIL_PROMO_FOLDERS="INBOX"
APPLE_MAIL_PROMO_DAYS=60

# Recent receipt sync stays deliberately short so routine updates are fast.
APPLE_MAIL_RECEIPT_FOLDER="Uber Receipts"
APPLE_MAIL_RECEIPT_SYNC_DAYS=120

# Recent receipt-like Uber Eats emails found in Inbox are moved here before
# export. The router is conservative and only moves messages with receipt/order
# wording plus receipt totals.
APPLE_MAIL_RECEIPT_ROUTE_DAYS=120

# Historical receipt history is imported separately in bounded chunks.
APPLE_MAIL_RECEIPT_HISTORY_DAYS=3650
APPLE_MAIL_RECEIPT_BACKFILL_CHUNK_DAYS=120

TRACKER_PRIVATE_DB="uber-tracker.local.db"
